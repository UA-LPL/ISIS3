########################################################
# Specifies Bullet ray-tracing engine for processing with
# shape models.
#
# RayTraceEngine = Bullet
# OnError = Continue | Fail
# Tolerance = { numerical value that will be set as the
#           tolerance for the Bullet or Embree shape
#           model }
#
########################################################

Group = ShapeModel
  RayTraceEngine = Bullet
  OnError = Continue
EndGroup

End
