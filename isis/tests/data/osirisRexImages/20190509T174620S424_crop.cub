              2001A&A...376..359H"

  # Creation date UTC (YYYY-MM-DD) of FITS header
  DATE     = 2019-08-11

  # Mission: OSIRIS-REx
  MISSION  = OSIRIS-REx

  # PDS terminology for spacecraft name
  HOSTNAME = OREX

  # Instrument: OCAMS
  INSTRUME = OCAMS

  # Target Object
  TARGET   = BENNU

  # UofA SPOC
  ORIGIN   = SPOC

  # Mission Phase
  MPHASE   = "Detailed Survey"

  # Equivalent to primary result summary
